    "def stack_labels(ax, x, items, gap, log=False):\n",
    "    # items: (marker x, y, text, colour). Write them right of x in y order, at least gap apart\n",
    "    # (in log10 units on a log axis), each joined to its marker by a thin line in the series colour.\n",
    "    to = (lambda v: np.log10(v)) if log else (lambda v: v)\n",
    "    back = (lambda v: 10.0 ** v) if log else (lambda v: v)\n",
    "    items = sorted(items, key=lambda item: item[1])\n",
    "    ys = [to(item[1]) for item in items]\n",
    "    for i in range(1, len(ys)):\n",
    "        ys[i] = max(ys[i], ys[i - 1] + gap)\n",
    "    for (x0, y0, text, colour), y in zip(items, ys):\n",
    "        ax.plot([x0 + 0.08, x - 0.03], [y0, back(y)], color=colour, lw=1)\n",
    "        ax.text(x, back(y), text, color=INK, ha=\"left\", va=\"center\", fontsize=8)\n",
    "\n",
